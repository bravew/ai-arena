{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-arena.dev/schemas/bundle-schema.json",
  "title": "AI Arena Report Bundle",
  "type": "object",
  "required": ["bundle_version", "run", "contestants", "trials", "calls", "scores", "sessions", "kit_installs", "artifacts"],
  "properties": {
    "bundle_version": {"const": 1},
    "run": {"$ref": "#/$defs/run"},
    "contestants": {"type": "array", "items": {"$ref": "#/$defs/contestant"}, "minItems": 1},
    "trials": {"type": "array", "items": {"$ref": "#/$defs/trial"}},
    "calls": {"type": "array", "items": {"$ref": "#/$defs/call"}},
    "scores": {"type": "array", "items": {"$ref": "#/$defs/score"}},
    "sessions": {"type": "array", "items": {"$ref": "#/$defs/session"}},
    "kit_installs": {"type": "array", "items": {"$ref": "#/$defs/kitInstall"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
  },
  "additionalProperties": false,
  "$defs": {
    "run": {"type": "object", "required": ["id", "suite_id", "started_at", "status"], "properties": {"id": {"type": "string"}, "suite_id": {"type": "string"}, "started_at": {"type": "string", "format": "date-time"}, "ended_at": {"type": ["string", "null"], "format": "date-time"}, "status": {"enum": ["running", "succeeded", "failed", "errored", "cancelled"]}}, "additionalProperties": false},
    "contestant": {"type": "object", "required": ["id", "model", "params", "scaffold", "scaffold_prompt", "kit_hash", "orchestration", "hooks"], "properties": {"id": {"type": "string", "minLength": 1}, "label": {"type": ["string", "null"]}, "model": {"type": "string"}, "params": {"type": "object"}, "scaffold": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["id", "version", "settings"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "settings": {"type": "object"}}, "additionalProperties": false}]}, "scaffold_prompt": {"enum": ["native", "pinned"]}, "kit_hash": {"type": "string"}, "orchestration": {"type": "string"}, "prompt_version": {"type": ["string", "null"]}, "hooks": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "trial": {"type": "object", "required": ["id", "run_id", "contestant_id", "task_id", "attempt", "status", "flags"], "properties": {"id": {"type": "string"}, "run_id": {"type": "string"}, "contestant_id": {"type": "string"}, "task_id": {"type": "string"}, "attempt": {"type": "integer", "minimum": 1}, "status": {"enum": ["queued", "running", "succeeded", "failed", "errored", "timeout", "skipped"]}, "error_class": {"type": ["string", "null"]}, "flags": {"type": "object", "required": ["unmetered", "swapped", "subscription_served", "kit_unapplied"], "properties": {"unmetered": {"type": "boolean"}, "swapped": {"type": "boolean"}, "subscription_served": {"type": "boolean"}, "kit_unapplied": {"type": "boolean"}}, "additionalProperties": false}, "started_at": {"type": ["string", "null"], "format": "date-time"}, "ended_at": {"type": ["string", "null"], "format": "date-time"}}, "additionalProperties": false},
    "call": {"type": "object", "required": ["id", "seq", "run_id", "purpose", "protocol_in", "protocol_out", "translated", "provider", "account_id", "model_asked", "swapped", "tries", "status", "tokens", "cost_usd", "queue_ms", "total_ms", "cache", "prompt_parts"], "properties": {"id": {"type": "string"}, "seq": {"type": "integer", "minimum": 1}, "run_id": {"type": "string"}, "trial_id": {"type": ["string", "null"]}, "span_id": {"type": ["string", "null"]}, "parent_span_id": {"type": ["string", "null"]}, "purpose": {"enum": ["contestant", "judge", "orchestration", "arena"]}, "protocol_in": {"type": "string"}, "protocol_out": {"type": "string"}, "translated": {"type": "boolean"}, "provider": {"type": "string"}, "account_id": {"type": "string"}, "model_asked": {"type": "string"}, "model_served": {"type": ["string", "null"]}, "swapped": {"type": "boolean"}, "upstream": {"type": ["string", "null"]}, "effort_asked": {"type": ["string", "null"]}, "effort_applied": {"type": ["string", "null"]}, "tries": {"type": "array", "items": {"type": "object", "required": ["account_id", "rest_ms", "ms"], "properties": {"account_id": {"type": "string"}, "status": {"type": ["integer", "null"]}, "error_class": {"type": ["string", "null"]}, "rest_ms": {"type": "integer", "minimum": 0}, "ms": {"type": "integer", "minimum": 0}}, "additionalProperties": false}}, "status": {"type": ["integer", "null"]}, "error_class": {"type": ["string", "null"]}, "tokens": {"$ref": "#/$defs/tokens"}, "cost_usd": {"type": ["number", "null"], "minimum": 0}, "price_version": {"type": ["string", "null"]}, "queue_ms": {"type": "integer", "minimum": 0}, "ttft_ms": {"type": ["integer", "null"]}, "first_text_ms": {"type": ["integer", "null"]}, "total_ms": {"type": "integer", "minimum": 0}, "cache": {"enum": ["hit", "miss", "off"]}, "prompt_parts": {"type": "array", "items": {"type": "object", "required": ["kind", "tokens"], "properties": {"kind": {"enum": ["system", "tools", "instructions", "files", "conversation"]}, "tokens": {"type": "integer", "minimum": 0}}, "additionalProperties": false}}}, "additionalProperties": false},
    "tokens": {"type": "object", "required": ["in", "out", "reasoning", "cache_read", "cache_write"], "properties": {"in": {"type": "integer", "minimum": 0}, "out": {"type": "integer", "minimum": 0}, "reasoning": {"type": "integer", "minimum": 0}, "cache_read": {"type": "integer", "minimum": 0}, "cache_write": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "score": {"type": "object", "required": ["trial_id", "scorer_id", "scorer_version", "value", "normalized", "passed", "rationale", "evidence"], "properties": {"trial_id": {"type": "string"}, "scorer_id": {"type": "string"}, "scorer_version": {"type": "string"}, "value": {"type": "number"}, "normalized": {"type": "number", "minimum": 0, "maximum": 1}, "passed": {"type": ["boolean", "null"]}, "rationale": {"type": "string"}, "evidence": {"type": "object"}}, "additionalProperties": false},
    "session": {"type": "object", "required": ["id", "trial_id", "agent", "status", "turns"], "properties": {"id": {"type": "string"}, "trial_id": {"type": "string"}, "parent_session_id": {"type": ["string", "null"]}, "agent": {"type": "string"}, "native_session_id": {"type": ["string", "null"]}, "started_at": {"type": ["string", "null"], "format": "date-time"}, "ended_at": {"type": ["string", "null"], "format": "date-time"}, "status": {"type": "string"}, "turns": {"type": "array", "items": {"$ref": "#/$defs/turn"}}}, "additionalProperties": false},
    "turn": {"type": "object", "required": ["call_ids", "tool_calls", "skill_events", "mcp_calls", "files", "unmetered"], "properties": {"call_ids": {"type": "array", "items": {"type": "string"}}, "tool_calls": {"type": "array", "items": {"type": "object", "required": ["name", "args_digest", "result_size", "duration_ms", "exit_status"], "properties": {"name": {"type": "string"}, "args_digest": {"type": "string"}, "result_size": {"type": "integer"}, "duration_ms": {"type": "integer"}, "exit_status": {"type": ["integer", "null"]}}, "additionalProperties": false}}, "skill_events": {"type": "array", "items": {"$ref": "#/$defs/skillEvent"}}, "mcp_calls": {"type": "array", "items": {"type": "object", "required": ["server", "tool", "duration_ms", "status"], "properties": {"server": {"type": "string"}, "tool": {"type": "string"}, "duration_ms": {"type": "integer"}, "status": {"type": "string"}}, "additionalProperties": false}}, "files": {"type": "array", "items": {"type": "object", "required": ["path", "added", "removed"], "properties": {"path": {"type": "string"}, "added": {"type": "integer"}, "removed": {"type": "integer"}}, "additionalProperties": false}}, "unmetered": {"type": "boolean"}}, "additionalProperties": false},
    "skillEvent": {"type": "object", "required": ["kind", "skill", "kit_hash"], "properties": {"kind": {"enum": ["listed", "loaded", "invoked"]}, "skill": {"type": "string"}, "kit_hash": {"type": "string"}}, "additionalProperties": false},
    "kitInstall": {"type": "object", "required": ["trial_id", "kit_hash", "written", "refused"], "properties": {"trial_id": {"type": "string"}, "kit_hash": {"type": "string"}, "written": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}}, "refused": {"type": "array", "items": {"type": "object", "required": ["item", "reason"], "properties": {"item": {"type": "string"}, "reason": {"type": "string"}}, "additionalProperties": false}}}, "additionalProperties": false},
    "artifact": {"type": "object", "required": ["sha256", "path", "mime", "render_hint"], "properties": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "path": {"type": "string"}, "mime": {"type": "string"}, "render_hint": {"enum": ["code", "diff", "markdown", "html-sandbox", "svg", "image", "json"]}}, "additionalProperties": false}
  }
}
